{
  "name": "live-chat-client",
  "version": "1.1.5",
  "description": "",
  "main": "main.js",
  "build": {
    "appId": "com.livechat.electron",
    "productName": "Live Chat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "src/**/*",
      "assets/**/*",
      "css/**/*",
      "package.json",
      "!node_modules/onnxruntime-web/**",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/{linux,darwin}/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/ffprobe-static/bin/{linux,darwin}/**",
        "!node_modules/ffprobe-static/bin/win32/ia32/**"
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/{linux,win32}/**",
        "!node_modules/ffprobe-static/bin/{linux,win32}/**",
        "!node_modules/ffprobe-static/bin/darwin/x64/**"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "ted-sama",
      "repo": "live-chat-client",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ]
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:css": "sass --watch css/style.scss css/style.css",
    "publish": "electron-builder --win --publish=always",
    "publish:mac": "electron-builder --mac --publish=always",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "electron-store": "8.1.0",
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "ffmpeg-static",
      "onnxruntime-node",
      "sharp"
    ]
  }
}
