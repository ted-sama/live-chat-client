{
  "name": "live-chat-client",
  "version": "1.1.7",
  "description": "Live Chat desktop client",
  "main": "main.js",
  "build": {
    "appId": "com.livechat.electron",
    "productName": "Live Chat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "assets/**/*",
      "css/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment"
    },
    "publish": {
      "provider": "github",
      "owner": "ted-sama",
      "repo": "live-chat-client",
      "releaseType": "release"
    }
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:css": "sass --watch css/style.scss css/style.css",
    "publish": "electron-builder --win --publish=always",
    "publish:mac": "electron-builder --mac --publish=always",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "electron-store": "8.1.0",
    "electron-updater": "^6.3.9",
    "socket.io-client": "^4.8.1"
  }
}
